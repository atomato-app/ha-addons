{
  "name": "Atomato",
  "version": "0.4.1",
  "slug": "atomato",
  "description": "Smooth Home Automations",
  "arch": [
    "amd64",
    "aarch64",
    "armhf",
    "armv7"
  ],
  "startup": "services",
  "init": false,
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8471,
  "ports": {
    "8470/tcp": 8470
  },
  "ports_description": {
    "8470/tcp": "Atomato dashboard HTTPS (LAN / mobile app; pin cert via /connection)"
  },
  "hassio_api": true,
  "hassio_role": "admin",
  "homeassistant_api": true,
  "services": [
    "mqtt:want"
  ],
  "options": {
    "beer": true,
    "z2m_base_topic": "zigbee2mqtt"
  },
  "schema": {
    "beer": "bool",
    "z2m_base_topic": "str?"
  },
  "image": "ghcr.io/atomato-app/atomato-ha-addon"
}
