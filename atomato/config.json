{
  "name": "Atomato",
  "version": "0.2.5",
  "slug": "atomato",
  "description": "Smooth Home Assistant Management",
  "arch": [
    "amd64",
    "aarch64",
    "armhf",
    "armv7"
  ],
  "startup": "services",
  "init": false,
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8470,
  "ports": {
    "8470/tcp": 8470
  },
  "ports_description": {
    "8470/tcp": "Atomato dashboard API (LAN / mobile app)"
  },
  "hassio_api": true,
  "hassio_role": "admin",
  "homeassistant_api": true,
  "options": {
    "beer": true
  },
  "schema": {
    "beer": "bool"
  },
  "image": "ghcr.io/atomato-app/atomato-ha-addon"
}
